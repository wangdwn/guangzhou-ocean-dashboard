    {
      "id": "fund_flow",
      "name": "资金流",
      "description": "融资事件/招投标金额/信贷数据",
      "unit": "万元",
      "sources": ["企查查", "中国政府采购网", "Wind"]
    },
    {
      "id": "logistics_flow",
      "name": "物流/交通流",
      "description": "AIS船舶/港口吞吐量/物流指数",
      "unit": "TEU/艘",
      "sources": ["广州港务局", "GFW AIS", "MarineTraffic"]
    },
    {
      "id": "market_entity",
      "name": "市场主体流",
      "description": "企业注册/招聘/司法案件",
      "unit": "家/人",
      "sources": ["天眼查", "企查查", "智联招聘"]
    },
    {
      "id": "industry_chain",
      "name": "产业链流",
      "description": "订单/许可/药监/专利",
      "unit": "件",
      "sources": ["国家知识产权局", "药监局", "海关总署"]
    },
    {
      "id": "env_risk",
      "name": "环境与风险流",
      "description": "海温/台风/赤潮/灾害预警",
      "unit": "°C/级",
      "sources": ["NOAA", "NHC", "南海预报中心"]
    },
    {
      "id": "policy",
      "name": "政策流",
      "description": "扶持政策/专项资金/规划文件",
      "unit": "项",
      "sources": ["国家发改委", "广东省", "广州市"]
